# ============================================================
# Atlas – Digital Banking Intelligence Platform
# Environment Configuration Template  (v2 – Sprint 2)
# NEVER commit .env to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
ATLAS_ENV=development
ATLAS_VERSION=1.0.0
ATLAS_SECRET_KEY=change-this-to-a-secure-random-string-in-production
# Must match the frontend's VITE_API_KEY exactly. Note: once the
# frontend is built and deployed, this value is visible in the public
# JS bundle (see frontend/.env.example) — it is not a real secret in
# a public deployment, only a coarse client-identification check.
ATLAS_API_KEY=change-this-to-a-secure-random-string-in-production
ATLAS_DEBUG=true
ATLAS_LOG_LEVEL=INFO
ATLAS_PORT=8000
ATLAS_API_PREFIX=/api/v1
# Local dev defaults shown below. For a deployed backend, set this to
# the real deployed frontend origin(s) (e.g. your Cloudflare Pages
# URL), comma-separated if more than one. Requests from origins not
# listed here will be rejected by the browser.
ATLAS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ATLAS_PUBLIC_URL=http://localhost:8000

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas_db
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=atlas_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO=false

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=atlas_redis_password

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Data Generation ─────────────────────────────────────────
DATA_SEED=42
DATA_CUSTOMER_COUNT=500000
DATA_TRANSACTION_MULTIPLIER=10
DATA_HISTORY_YEARS=3
DATA_START_DATE=2022-01-01
DATA_OUTPUT_DIR=data/raw

# ─── Analytics Engine ────────────────────────────────────────
ANALYTICS_BATCH_SIZE=10000
ANALYTICS_CACHE_TTL_SECONDS=300
ANALYTICS_FORECAST_HORIZON_DAYS=90
ANALYTICS_CHURN_LOOKBACK_DAYS=90

# ─── ETL Pipeline ────────────────────────────────────────────
ETL_SCHEDULE_CRON=0 2 * * *
ETL_STAGING_PATH=data/staging
ETL_RAW_PATH=data/raw
ETL_BATCH_SIZE=50000

# Atlas frontend — environment configuration
# Copy to .env.local and fill in real values; Vite only exposes
# variables prefixed VITE_ to client code.
#
# Deployment note: both variables below are read at BUILD time and
# compiled directly into the public JS bundle. VITE_API_KEY is
# therefore NOT a secret once deployed — anyone can view it in the
# browser's dev tools. It only works as a coarse "requests came from
# our frontend" check, appropriate for a public demo serving synthetic
# data only. See README.md's Known Limitations for detail.

# Local dev default shown below. For a deployed frontend, set this to
# the real deployed backend URL (e.g. your Render service's URL) —
# never leave it pointed at localhost in a production build.
VITE_API_BASE_URL=http://localhost:8000

# Must match the backend's ATLAS_API_KEY exactly. See the note above.
VITE_API_KEY=change-this-to-a-secure-random-string-in-production
